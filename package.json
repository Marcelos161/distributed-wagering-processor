{
  "name": "distributed-wagering-processor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": ">=1.4.3 <2"
  },
  "scripts": {
    "infra:up": "docker compose up -d --wait --wait-timeout 120",
    "infra:down": "docker compose down",
    "infra:status": "docker compose ps",
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "start:built": "bun dist/main.js",
    "build": "bun x --bun --no-install tsc -p tsconfig.build.json",
    "typecheck": "bun x --bun --no-install tsc --noEmit",
    "test": "bun test ./test",
    "test:infra:postgres": "bun test ./infra/test/postgres.test.ts",
    "test:infra:sqs": "bun test ./infra/test/sqs.test.ts",
    "test:infra": "bun run test:infra:postgres && bun run test:infra:sqs",
    "test:orm": "bun test ./infra/test/orm.test.ts",
    "test:migrations": "bun test ./infra/test/migrations.test.ts",
    "migration:create": "bun --bun node_modules/@mikro-orm/cli/cli.js migration:create --blank --config mikro-orm.config.ts",
    "migration:up": "bun --bun node_modules/@mikro-orm/cli/cli.js migration:up --config mikro-orm.config.ts",
    "migration:down": "bun --bun node_modules/@mikro-orm/cli/cli.js migration:down --config mikro-orm.config.ts",
    "migration:pending": "bun --bun node_modules/@mikro-orm/cli/cli.js migration:pending --config mikro-orm.config.ts",
    "migration:list": "bun --bun node_modules/@mikro-orm/cli/cli.js migration:list --config mikro-orm.config.ts",
    "check": "bun run typecheck && bun run test && bun run build",
    "test:financial": "bun test ./infra/test/financial-wallet.test.ts ./infra/test/financial-wager.test.ts ./infra/test/financial-ledger.test.ts",
    "test:persistence": "bun test ./infra/test/persistence-*.test.ts",
    "test:messaging": "bun test ./infra/test/messaging-*.test.ts",
    "test:wallet-creation": "bun test ./infra/test/wallet-creation-*.test.ts",
    "test:bet": "bun test ./infra/test/bet-*.test.ts",
    "test:wager": "bun test ./infra/test/wager-*.test.ts",
    "test:refund": "bun test ./infra/test/refund-*.test.ts",
    "test:rollback": "bun test ./infra/test/rollback.test.ts",
    "worker:references": "bun src/reference-worker.ts",
    "test:references": "bun test ./infra/test/pending-reference.test.ts",
    "test:api": "bun test ./infra/test/api.test.ts",
    "worker:consumer": "bun src/consumer.ts",
    "test:consumer": "bun test ./infra/test/consumer.test.ts",
    "worker:publisher": "bun src/publisher.ts",
    "test:publisher": "bun test ./infra/test/publisher.test.ts",
    "test:distributed": "bun test ./infra/test/distributed.test.ts",
    "lint": "bun x --bun --no-install eslint src test infra/test scripts migrations mikro-orm.config.ts",
    "test:delivery-migrations": "bun test ./infra/test/delivery-migrations.test.ts",
    "demo:setup": "bun scripts/demo-setup.ts",
    "test:all": "bun run lint && bun run check && bun run test:financial && bun run test:persistence && bun run test:messaging && bun run test:wallet-creation && bun run test:bet && bun run test:wager && bun run test:refund && bun run test:rollback && bun run test:references && bun run test:api && bun run test:consumer && bun run test:publisher && bun run test:distributed && bun run test:delivery-migrations && bun run test:orm && bun run test:migrations && bun run test:infra"
  },
  "dependencies": {
    "@mikro-orm/core": "7.2.5",
    "@mikro-orm/nestjs": "7.1.0",
    "@mikro-orm/postgresql": "7.2.5",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "decimal.js": "10.6.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "@aws-sdk/client-sqs": "3.1154.0"
  },
  "devDependencies": {
    "@mikro-orm/cli": "7.2.5",
    "@mikro-orm/migrations": "7.2.5",
    "@types/bun": "1.4.3",
    "eslint": "10.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  }
}
