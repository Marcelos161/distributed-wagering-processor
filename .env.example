HOST=127.0.0.1
PORT=3000

# Local development only. Initial credentials apply when the volume is empty.
POSTGRES_DB=wagering
POSTGRES_PORT=55432
POSTGRES_ADMIN_PASSWORD=local_admin_only
POSTGRES_APP_PASSWORD=local_app_only

# NestJS connection from the host; update if the values above change.
DATABASE_URL=postgresql://wager_app:local_app_only@127.0.0.1:55432/wagering
# Separate administrative migration job only; never used by the application.
MIGRATION_DATABASE_URL=postgresql://wager_admin:local_admin_only@127.0.0.1:55432/wagering

# Emulated AWS only: never put real AWS or LocalStack account credentials here.
LOCALSTACK_PORT=4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_EC2_METADATA_DISABLED=true
SQS_ENDPOINT=http://127.0.0.1:4566
SQS_QUEUE_NAME=wager-transactions.fifo
SQS_DLQ_NAME=wager-transactions-dlq.fifo

# Durable reference resolution: first delay 1s, cap 5min, at most 300 checks or 24h.
REFERENCE_MAX_ATTEMPTS=300
REFERENCE_TTL_MS=86400000
REFERENCE_INITIAL_DELAY_MS=1000
REFERENCE_MAX_DELAY_MS=300000
SQS_VISIBILITY_SECONDS=30
SQS_RETRY_SECONDS=1
